# ===================================================================
# HallsAnr Web App - Environment Variables Configuration
# ===================================================================

# 1. APPLICATION & AUTHENTICATION
PORT=3000
NODE_ENV=production
JWT_SECRET=super-secret-jwt-key-replace-this-with-a-random-32-char-string
OWNER_USERNAME=hall
OWNER_PASSWORD=hall1234

# 2. MICROSOFT AZURE SQL DATABASE
# You can provide either the full connection string OR individual credentials:
AZURE_SQL_CONNECTION_STRING=Server=tcp:your-azure-sql-server.database.windows.net,1433;Initial Catalog=hallsanrdb;Persist Security Info=False;User ID=yourusername;Password=yourpassword;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Or individual parameters:
# AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
# AZURE_SQL_DATABASE=hallsanrdb
# AZURE_SQL_USER=yourusername
# AZURE_SQL_PASSWORD=yourpassword
# AZURE_SQL_PORT=1433

# 3. MICROSOFT AZURE BLOB STORAGE
# Connection string from Azure Portal -> Storage Account -> Access Keys:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourStorageAccountKey==;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=hallsanr-media
